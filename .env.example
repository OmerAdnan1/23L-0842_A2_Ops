# Copy to .env and fill in. .env is git-ignored and never baked into an image.

# --- MLflow on DagsHub (Task 3) ---
MLFLOW_TRACKING_URI=https://dagshub.com/<user>/<repo>.mlflow
MLFLOW_TRACKING_USERNAME=<dagshub-username>
MLFLOW_TRACKING_PASSWORD=<dagshub-token>

# --- Web app (Task 4) ---
INFERENCE_MODE=local
MODEL_PATH=models/champion.keras
MODEL_NAME=VisionGuard-23L-0842@champion
THRESHOLD=0.80
MAX_UPLOAD_MB=5
DATABASE_URL=sqlite:///visionguard.db
SECRET_KEY=<random-hex>

# --- PostgreSQL for Docker Compose (Task 6) - letters/digits only ---
POSTGRES_USER=visionguard
POSTGRES_PASSWORD=<strong-password>
POSTGRES_DB=visionguard

# --- Model API (Task 7: API_KEY on the server, Task 8: URL + key in the web app) ---
API_KEY=<long-random-key>
MODEL_API_URL=https://<your-cloud-run-url>
MODEL_API_KEY=<same-long-random-key>
